# Copy to `.env` and fill in the values.

# Postgres from `docker compose up -d db` (host port 5432).
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Database used by the test suite (created by docker/postgres-init).
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app_test

# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173"]

# Keitaro Admin API.
KEITARO_API_URL=https://keitaro-for-tests.etolegko.com/admin_api
KEITARO_API_KEY=

# Campaign creator defaults.
GOOGLE_URL=https://google.com
DEFAULT_DOMAIN_ID=
DEFAULT_GROUP_ID=
DEFAULT_TRAFFIC_SOURCE_ID=

# How long the local offer catalog is considered fresh.
OFFERS_CACHE_TTL_MINUTES=10
